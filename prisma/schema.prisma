// Marginlane workspace data (AppData as JSON document)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Isoliertes Projekt: Investa oder Costerra — jede Zeile = eigene AppData-Datenbank (kein Shared State).
model Workspace {
  id        String   @id @default(cuid())
  name      String
  /// "invest" | "batches" | "batches_wholesale" — Produkt-/Modul-Zugehörigkeit
  module    String
  /// Kompletter App-Stand nur für dieses Projekt
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([module])
}
